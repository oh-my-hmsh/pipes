{
  "$schema": "https://oh-my-hsh.navii.online/schemas/pipe-v1.json",
  "id": "flux-grep",
  "name": "flux-grep",
  "bin_name": "flux-grep",
  "version": "3.0.0",
  "description": "Fast signal extraction from NDJSON streams. Filter and search structured data at speed.",
  "usage": "flux-grep TODO ~/project",
  "author": "takakix2",
  "license": "MIT",
  "runtime": "binary",
  "tags": [
    "search",
    "filter",
    "official"
  ],
  "min_hsh_version": "0.1.0",
  "verbs": [
    {
      "verb": "fgr",
      "kind": "source",
      "template": "flux-grep {pattern} {path}",
      "args": [
        {
          "name": "pattern",
          "type": "str"
        },
        {
          "name": "path",
          "type": "path"
        }
      ],
      "output": "line"
    }
  ],
  "category": "source",
  "platforms": [
    "linux-x86_64",
    "windows-x86_64"
  ]
}

{
  "$schema": "https://oh-my-hsh.navii.online/schemas/pipe-v1.json",
  "id": "flux-eye",
  "name": "flux-eye",
  "bin_name": "flux-eye",
  "version": "0.1.0",
  "description": "High-speed filesystem scanner. Streams directory structure as Flux NDJSON.",
  "usage": "flux-eye ~/project --detail",
  "author": "takakix2",
  "license": "MIT",
  "runtime": "binary",
  "tags": [
    "filesystem",
    "scanner",
    "official"
  ],
  "min_hsh_version": "0.1.0",
  "verbs": [
    {
      "verb": "feye",
      "kind": "source",
      "template": "flux-eye {path} --detail",
      "args": [
        {
          "name": "path",
          "type": "path"
        }
      ],
      "output": "line"
    }
  ],
  "category": "source",
  "platforms": [
    "linux-x86_64",
    "windows-x86_64",
    "macos-aarch64"
  ]
}

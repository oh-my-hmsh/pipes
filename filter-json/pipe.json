{
  "$schema": "https://oh-my-hsh.navii.online/schemas/pipe-v1.json",
  "id": "filter-json",
  "name": "filter-json",
  "bin_name": "filter-json",
  "source": "filter-json/filter-json",
  "version": "0.1.0",
  "description": "Filters an NDJSON stream by keyword across all fields, or one named field. A lightweight jq stand-in for Flux pipelines.",
  "usage": "flux-eye . | filter-json --keyword rust",
  "author": "takakix2",
  "license": "MIT",
  "runtime": "python",
  "tags": [
    "filter",
    "json",
    "official"
  ],
  "min_hsh_version": "0.1.0",
  "input": "ndjson",
  "output": "ndjson",
  "category": "filter",
  "verbs": [
    {
      "verb": "fjson",
      "template": "filter-json",
      "args": []
    },
    {
      "verb": "fjson",
      "template": "filter-json --keyword {kw}",
      "args": [
        {
          "name": "kw",
          "type": "str"
        }
      ]
    }
  ]
}
